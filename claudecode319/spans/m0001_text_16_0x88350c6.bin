  setFunctionName(target, name);
  for (let i = decorators.length - 1; i >= 0; i--) {
    const done: any = {};
    const result = (0, decorators[i])(target, createClassContext(name, done, metadata, initializers));
    done._ = 1;
    expectFunction(result) && (target = result);
